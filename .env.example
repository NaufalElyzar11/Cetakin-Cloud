APP_NAME="Cetakin Cloud"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

# Host-only development defaults. Compose uses a separate generated .env.docker.
# Never use production credentials here. Migrate PostgreSQL before identity flows.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cetakin_dev
DB_USERNAME=cetakin_dev
DB_PASSWORD=cetakin_local_dev_only
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=false
# Set SESSION_SECURE_COOKIE=true for production HTTPS. Keep cookies host-only.
CACHE_STORE=database
LOG_CHANNEL=stderr
LOG_LEVEL=warning

VITE_APP_NAME="${APP_NAME}"

# Private local storage stays default. S3 settings must be explicitly configured.
# Docker's optional compatible service is synthetic-only, never real design intake.
DESIGN_OBJECT_DRIVER=local
CETAKIN_S3_ENDPOINT=
CETAKIN_S3_BUCKET=
CETAKIN_S3_KEY=
CETAKIN_S3_SECRET=
CETAKIN_S3_REGION=us-east-1
