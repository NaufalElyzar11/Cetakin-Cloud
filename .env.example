APP_NAME="Cetakin Cloud"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

# Host-only development defaults. Compose uses a separate generated .env.docker.
# Never use production credentials here. Bootstrap routes/tests remain database-free.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cetakin_dev
DB_USERNAME=cetakin_dev
DB_PASSWORD=cetakin_local_dev_only
DB_SSLMODE=prefer

SESSION_DRIVER=file
CACHE_STORE=array
LOG_CHANNEL=stderr
LOG_LEVEL=warning

VITE_APP_NAME="${APP_NAME}"
