{
    "name": "cetakin-cloud",
    "private": true,
    "type": "module",
    "engines": {
        "node": "^24.0.0"
    },
    "scripts": {
        "dev": "vite",
        "typecheck": "tsc --noEmit",
        "build": "vite build",
        "test:components": "vitest run",
        "format:check": "prettier --check resources/js resources/css vite.config.ts vitest.config.ts tsconfig.json package.json prettier.config.mjs",
        "format": "prettier --write resources/js resources/css vite.config.ts vitest.config.ts tsconfig.json package.json prettier.config.mjs"
    },
    "dependencies": {
        "@inertiajs/react": "3.8.0",
        "react": "19.3.0",
        "react-dom": "19.3.0"
    },
    "devDependencies": {
        "@testing-library/dom": "10.4.2",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@types/node": "24.19.1",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.2",
        "jsdom": "29.1.1",
        "laravel-vite-plugin": "3.2.0",
        "prettier": "3.9.9",
        "typescript": "7.0.2",
        "vite": "8.3.3",
        "vitest": "5.0.3"
    }
}
